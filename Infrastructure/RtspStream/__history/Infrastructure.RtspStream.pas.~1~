unit MiniVMS.Infrastructure.RtspStream;

interface

uses
  Winapi.Windows,
  MiniVMS.Application.Interfaces.CameraStream,
  MiniVMS.Application.Interfaces.RtspStream;

type
  TRtspStream = class(TInterfacedObject, IRtspStream)
  private
    FConnected: Boolean;

  public
    procedure Connect(
      const ASource: string;
      AHandle: HWND
    );

    procedure Disconnect;

    function IsConnected: Boolean;
  end;

implementation

procedure TRtspStream.Connect(
  const ASource: string;
  AHandle: HWND
);
begin
  {
    Aqui posteriormente entra VLC / FFmpeg.

    Exemplo conceitual:

    FVlc.SetWindow(AHandle);
    FVlc.Open(ASource);
    FVlc.Play;
  }

  FConnected := True;
end;

procedure TRtspStream.Disconnect;
begin
  {
    FVlc.Stop;
  }

  FConnected := False;
end;

function TRtspStream.IsConnected: Boolean;
begin
  Result := FConnected;
end;

end.
