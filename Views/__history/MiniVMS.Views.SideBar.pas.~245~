unit MiniVMS.Views.SideBar;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls,
  MiniVMS.Utils.UI, Vcl.Buttons,
  Vcl.Skia,
  MiniVMS.Application.Interfaces.RtspStream,
  MiniVMS.Application.Interfaces.CameraStream;

type

  TSideBarFrame = class(TFrame)
    pnlCardConection: TPanel;
    ipLabel: TLabel;
    plnConectionContainer: TPanel;
    userLabel: TLabel;
    urlRtspLabel: TLabel;
    passwordLabel: TLabel;
    laberPort: TLabel;

    PanelIPDomain: TPanel;

    PanelUsername: TPanel;
    EditUsername: TEdit;

    PanelRtspUrl: TPanel;
    EditUrlRtsp: TEdit;

    PanelPassword: TPanel;
    EditPassword: TEdit;

    PanelPort: TPanel;
    EditPort: TEdit;
    PanelActiveDevice: TPanel;
    PanelDesactiveDevice: TPanel;
    LabelConection: TLabel;
    PanelServerConnection: TPanel;
    ImgConnection: TImage;
    EditIpDomain: TEdit;
    PanelLastConections: TPanel;

    procedure FrameCreate(Sender: TObject);
    procedure PanelActiveDeviceClick(Sender: TObject);
    procedure PanelDesactiveDeviceClick(Sender: TObject);

  private

  FCameraStream: ICameraStream;
  FMonitorHandle: HWND;

  procedure RoundAllPanels(ARadius: Integer);

  public
    constructor Create(
      AOwner: TComponent;
      ACameraStream: ICameraStream;
      AMonitorHandle: HWND
    ); reintroduce;

    procedure ApplyStyle;

  end;

implementation

{$R *.dfm}

constructor TSidebarFrame.Create(
  AOwner: TComponent;
  ACameraStream: ICameraStream;
  AMonitorHandle: HWND
);

begin
  inherited Create(AOwner);

  FCameraStream := ACameraStream;
  FMonitorHandle := AMonitorHandle;

  ApplyStyle;
  RoundAllPanels(12);
end;

procedure TSideBarFrame.FrameCreate(Sender: TObject);

begin
    {Do something}
    ApplyStyle;

end;

procedure TSideBarFrame.ApplyStyle;
begin

   RoundAllPanels(12);

end;

procedure TSideBarFrame.RoundAllPanels(ARadius: Integer);
  var I: Integer;

    begin
      for I := 0 to ComponentCount - 1 do
      begin
        if Components[I] is TPanel then
           SetRoundedCorners(TPanel(Components[I]), ARadius);
      end;

    end;


procedure  TSideBarFrame.PanelActiveDeviceClick(Sender: TObject);
var
  Url: string;
begin
  Url := Trim(EditUrlRtsp.Text);

  if Url.IsEmpty then
  begin
    //ShowMessage('Informe a URL RTSP:');
    Exit;
  end;

  if Assigned(FCameraStream) then
    FCameraStream.Connect(Url, FMonitorHandle);
end;

procedure TSideBarFrame.PanelDesactiveDeviceClick(Sender: TObject);
var
    Url: string;
begin
   {DO something}
end;

end.
