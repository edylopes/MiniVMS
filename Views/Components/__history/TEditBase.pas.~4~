unit MiniVMSComponents.TEditBase;

interface

uses
  System.Classes,
  Vcl.StdCtrls;

type
  TEditBase = class(TEdit)
  public
    constructor Create(AOwner: TComponent); override;
  end;

implementation

constructor TEditBase.Create(AOwner: TComponent);
begin
  inherited;

  Alignment := taCenter;
  Height := 35;

  Font.Name := 'Segoe UI';
  Font.Size := 11;
end;

end.
