unit MiniVMS.Components.TEditBase;

interface

uses
  System.Classes,
  Vcl.StdCtrls;

type
  TEditBase = class(TEdit)
  public
    constructor Create(AOwner: TComponent); override;
  end;

procedure Register;

implementation

constructor TEditBase.Create(AOwner: TComponent);
begin
  inherited;

  Alignment := taCenter;
  Height := 35;

  Font.Name := 'Segoe UI';
  Font.Size := 11;
end;

procedure Register;
begin
  RegisterComponents('MiniVMS', [TEditBase]);
end;

end.
