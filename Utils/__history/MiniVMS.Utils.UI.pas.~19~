unit MiniVMS.Utils.UI;

interface

uses
  Winapi.Windows,
  Vcl.Controls;

procedure SetRoundedCorners(
  AControl: TWinControl;
  ARadius: Integer = 12
);

implementation

procedure SetRoundedCorners(
  AControl: TWinControl;
  ARadius: Integer
);
var
  Region: HRGN;
begin
  if not Assigned(AControl) then
    Exit;

  Region := CreateRoundRectRgn(
    0,
    0,
    AControl.Width -1,
    AControl.Height -1,
    ARadius *1,
    ARadius * 1
  );

  SetWindowRgn(
    AControl.Handle,
    Region,
    True
  );
end;

end.
